def listGetD {α : Type} (d : α) : List α → Nat → α
  | [], _ => d
  | x :: _, 0 => x
  | _ :: xs, n + 1 => listGetD d xs n

def listLast? {α : Type} : List α → Option α
  | [] => none
  | [x] => some x
  | _ :: xs => listLast? xs

def orient (a b c : Pt) : Int :=
  (b.1 - a.1) * (c.2 - a.2) - (b.2 - a.2) * (c.1 - a.1)

def edgesAux (first : Pt) : List Pt → List (Pt × Pt)
  | [] => []
  | [last] => [(last, first)]
  | a :: b :: rest => (a, b) :: edgesAux first (b :: rest)

def polyEdges : List Pt → List (Pt × Pt)
  | [] => []
  | p :: ps => edgesAux p (p :: ps)

def convexTriples (v0 v1 : Pt) : List Pt → Bool
  | [a, b] => orient a b v0 > 0 && orient b v0 v1 > 0
  | a :: b :: c :: rest => orient a b c > 0 && convexTriples v0 v1 (b :: c :: rest)
  | _ => false

def checkPolyConvex : List Pt → Bool
  | a :: b :: c :: rest =>
    (a :: b :: c :: rest).length == K && convexTriples a b (a :: b :: c :: rest)
  | _ => false

def checkAllPolys : List (List Pt) → Bool
  | [] => true
  | p :: ps => checkPolyConvex p && checkAllPolys ps

def checkConvexAll : Bool :=
  (polys.length == 9) && checkAllPolys polys

def segStatus (p1 p2 q1 q2 : Pt) : Int :=
  let x1min := if p1.1 <= p2.1 then p1.1 else p2.1
  let x1max := if p1.1 >= p2.1 then p1.1 else p2.1
  let x2min := if q1.1 <= q2.1 then q1.1 else q2.1
  let x2max := if q1.1 >= q2.1 then q1.1 else q2.1
  if x1max < x2min || x2max < x1min then 0 else
  let y1min := if p1.2 <= p2.2 then p1.2 else p2.2
  let y1max := if p1.2 >= p2.2 then p1.2 else p2.2
  let y2min := if q1.2 <= q2.2 then q1.2 else q2.2
  let y2max := if q1.2 >= q2.2 then q1.2 else q2.2
  if y1max < y2min || y2max < y1min then 0 else
  let dx1 := p2.1 - p1.1
  let dy1 := p2.2 - p1.2
  let dx2 := q2.1 - q1.1
  let dy2 := q2.2 - q1.2
  let det := dx1 * dy2 - dy1 * dx2
  if det == 0 then
    if orient p1 p2 q1 == 0 then -1 else 0
  else
    let rx := q1.1 - p1.1
    let ry := q1.2 - p1.2
    let tn := rx * dy2 - ry * dx2
    let un := rx * dy1 - ry * dx1
    if det > 0 then
      if tn < 0 || tn > det || un < 0 || un > det then 0
      else if tn == 0 || tn == det || un == 0 || un == det then -1
      else 1
    else
      if tn > 0 || tn < det || un > 0 || un < det then 0
      else if tn == 0 || tn == det || un == 0 || un == det then -1
      else 1

def edgePairLoop (e1 : Pt × Pt) : List (Pt × Pt) → Nat → Bool → Nat × Bool
  | [], cnt, ok => (cnt, ok)
  | e2 :: rest, cnt, ok =>
    let st := segStatus e1.1 e1.2 e2.1 e2.2
    if st == -1 then edgePairLoop e1 rest cnt false
    else if st == 1 then edgePairLoop e1 rest (cnt + 1) ok
    else edgePairLoop e1 rest cnt ok

def polyPairLoop (esJ : List (Pt × Pt)) : List (Pt × Pt) → Nat → Bool → Nat × Bool
  | [], cnt, ok => (cnt, ok)
  | e1 :: rest, cnt, ok =>
    let (c2, ok2) := edgePairLoop e1 esJ cnt ok
    polyPairLoop esJ rest c2 ok2

def pairStats (i j : Nat) : Nat × Bool :=
  polyPairLoop (polyEdges (listGetD [] polys j)) (polyEdges (listGetD [] polys i)) 0 true

def checkRowAux (i : Nat) : Nat → Nat → Bool → Nat → Bool
  | 0, acc, ok, expected => ok && (acc == expected)
  | rem + 1, acc, ok, expected =>
    let j := 8 - rem
    if j <= i then checkRowAux i rem acc ok expected
    else
      let (cnt, noDegen) := pairStats i j
      checkRowAux i rem (acc + cnt) (ok && noDegen && (cnt >= 2)) expected

def checkRow (i expectedRowSum : Nat) : Bool :=
  checkRowAux i 9 0 true expectedRowSum

def crossValid (x : Nat × Nat × Nat × Nat) : Bool :=
  let (i, ei, j, ej) := x
  (i < j) && (j < 9) && (ei < K) && (ej < K) &&
  let pi := listGetD [] polys i
  let pj := listGetD [] polys j
  segStatus (listGetD (0, 0) pi ei) (listGetD (0, 0) pi ((ei + 1) % K))
            (listGetD (0, 0) pj ej) (listGetD (0, 0) pj ((ej + 1) % K)) == 1

def checkCrossListValid : List (Nat × Nat × Nat × Nat) → Bool
  | [] => true
  | x :: rest => crossValid x && checkCrossListValid rest

def crossPt (x : Nat × Nat × Nat × Nat) : Int × Int × Int :=
  let (i, ei, j, ej) := x
  let pi := listGetD [] polys i
  let pj := listGetD [] polys j
  let p1 := listGetD (0, 0) pi ei
  let p2 := listGetD (0, 0) pi ((ei + 1) % K)
  let q1 := listGetD (0, 0) pj ej
  let q2 := listGetD (0, 0) pj ((ej + 1) % K)
  let dx1 := p2.1 - p1.1
  let dy1 := p2.2 - p1.2
  let dx2 := q2.1 - q1.1
  let dy2 := q2.2 - q1.2
  let det := dx1 * dy2 - dy1 * dx2
  let rx := q1.1 - p1.1
  let ry := q1.2 - p1.2
  let tn := rx * dy2 - ry * dx2
  let xn := p1.1 * det + tn * dx1
  let yn := p1.2 * det + tn * dy1
  if det > 0 then (xn, yn, det) else (-xn, -yn, -det)

def ratPtLt (a b : Int × Int × Int) : Bool :=
  let lx := a.1 * b.2.2
  let rx := b.1 * a.2.2
  if lx != rx then lx < rx else a.2.1 * b.2.2 < b.2.1 * a.2.2

def checkCrossStrictAux (prev : Int × Int × Int) : List (Nat × Nat × Nat × Nat) → Bool
  | [] => true
  | b :: rest =>
    let pb := crossPt b
    ratPtLt prev pb && checkCrossStrictAux pb rest

def checkCrossListStrict : List (Nat × Nat × Nat × Nat) → Bool
  | [] => true
  | a :: rest => checkCrossStrictAux (crossPt a) rest

def checkCrossBridge (a b : List (Nat × Nat × Nat × Nat)) : Bool :=
  match listLast? a, b with
  | some x, y :: _ => ratPtLt (crossPt x) (crossPt y)
  | _, _ => false

def checkCrossChunk (xs : List (Nat × Nat × Nat × Nat)) : Bool :=
  (xs.length == 51) && checkCrossListValid xs && checkCrossListStrict xs

def checkCrossBridgesAll : Bool :=
  checkCrossBridge cross0 cross1 &&
  checkCrossBridge cross1 cross2 &&
  checkCrossBridge cross2 cross3 &&
  checkCrossBridge cross3 cross4 &&
  checkCrossBridge cross4 cross5 &&
  checkCrossBridge cross5 cross6 &&
  checkCrossBridge cross6 cross7 &&
  checkCrossBridge cross7 cross8 &&
  checkCrossBridge cross8 cross9

def edgesInsideLoop (wx wy sw : Int) : List (Pt × Pt) → Bool
  | [] => true
  | (v1, v2) :: rest =>
    orient (v1.1 * sw, v1.2 * sw) (v2.1 * sw, v2.2 * sw) (wx, wy) > 0 &&
    edgesInsideLoop wx wy sw rest

def checkPolyInside (c : Nat) (wx wy sw : Int) : Bool :=
  edgesInsideLoop wx wy sw (polyEdges (listGetD [] polys c))

def checkPolyOutside (c e : Nat) (wx wy sw : Int) : Bool :=
  let poly := listGetD [] polys c
  (e < K) &&
  let v1 := listGetD (0, 0) poly e
  let v2 := listGetD (0, 0) poly ((e + 1) % K)
  orient (v1.1 * sw, v1.2 * sw) (v2.1 * sw, v2.2 * sw) (wx, wy) < 0

def checkWitnessCurves (mask : Nat) (wx wy : Int) (outEdges : List Nat) : Nat → Bool
  | 0 => true
  | n + 1 =>
    let ok :=
      if (mask / (2 ^ n)) % 2 == 1 then
        checkPolyInside n wx wy witnessScale
      else
        checkPolyOutside n (listGetD 99 outEdges n) wx wy witnessScale
    ok && checkWitnessCurves mask wx wy outEdges n

def checkWitnessEntry (mask : Nat) (w : Int × Int × List Nat) : Bool :=
  let (wx, wy, outEdges) := w
  checkWitnessCurves mask wx wy outEdges 9

def checkWitnessList (mask : Nat) : List (Int × Int × List Nat) → Bool
  | [] => true
  | w :: rest => checkWitnessEntry mask w && checkWitnessList (mask + 1) rest

def checkWitnessChunk (startMask : Nat) (ws : List (Int × Int × List Nat)) : Bool :=
  (ws.length == 64) && checkWitnessList startMask ws

